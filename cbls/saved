              {/* Expanded Inspection Booking Panel */}
              {item.isExpanded && (
                <View style={{ marginTop: 12, borderTopWidth: 1, borderTopColor: borderColor, paddingTop: 12 }}>
                  <Text style={{ fontSize: 12, color: subTextColor, lineHeight: 18, marginBottom: 16 }}>
                    {item.description}
                  </Text>
                  <TouchableOpacity style={{ width: '100%', backgroundColor: '#2563EB', paddingVertical: 12, borderRadius: 12, flexDirection: 'row', alignItems: 'center', justifyContent: 'center' }} className="space-x-2">
                    <Text className="text-white font-bold text-sm">Book Inspection</Text>
                    <Sparkles size={14} color="#FFFFFF" />
                  </TouchableOpacity>
                </View>
              )}
            </View>
          </View>
        ))}

        {/* Bottom Discover More Block */}
        <TouchableOpacity style={{ borderStyle: 'dashed', borderWidth: 1, borderColor: isDark ? '#444444' : '#CBD5E1', borderRadius: 16, paddingVertical: 24, alignItems: 'center', justifyContent: 'center', marginBottom: 40, backgroundColor: cardInteriorBg }}>
          <Plus size={20} color={subTextColor} />
          <Text style={{ fontSize: 12, fontWeight: '600', color: subTextColor, marginTop: 8 }}>Discover More</Text>
        </TouchableOpacity>
      </ScrollView>
    </SafeAreaView>
  );
